<h1>Documentation</h1>
<p>Everything you need to build with SchemaFlux, from installation to advanced configuration.</p>

<div class="docs-index-group">
  <h3>Getting Started</h3>
  <div class="docs-grid">
    {% for doc in collections.docs %}
      {% if doc.data.section == "Getting Started" %}
      <a href="/docs/{{ doc.fileSlug }}/" class="doc-card">
        <h4>{{ doc.data.title }}</h4>
        <p>{{ doc.data.description }}</p>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

